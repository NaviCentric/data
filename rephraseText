/**
 * Components fixture
 * Provides execution components only (UI/API/Desktop/DB adapters via factory).
 */

import { expect, test as base } from '../../core/infrastructure/index';
import type { APIRequestContext, Page } from '@playwright/test';
import { ComponentFactory, type ComponentSuite } from '../../components/factory/index';
import { config } from '../../core/config/index';

export interface ComponentsFixture {
  components: ComponentSuite;
}

export const componentsFixturesWithPage = {
  components: async (
    { page, request }: { page: Page; request: APIRequestContext },
    use: (value: ComponentSuite) => Promise<void>,
    testInfo: { project: { name: string } }
  ): Promise<void> => {
    const factory = new ComponentFactory(page, request);
    await use(factory.createLazy());

    if (testInfo.project.name === 'chromium') {
      // eslint-disable-next-line playwright/no-wait-for-timeout
      await page.waitForTimeout(config.testing.chromiumTestEndDelayMs);
    }
  },
};

export const componentsFixturesNoPage = {
  components: async (
    { request }: { request: APIRequestContext },
    use: (value: ComponentSuite) => Promise<void>
  ): Promise<void> => {
    const factory = new ComponentFactory(undefined, request);
    await use(factory.createLazy());
  },
};

export const componentsFixtures = componentsFixturesWithPage;

export const componentsTest = base.extend<ComponentsFixture>(componentsFixturesWithPage);
export const componentsNoPageTest = base.extend<ComponentsFixture>(componentsFixturesNoPage);

export { expect };
