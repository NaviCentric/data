$action = New-ScheduledTaskAction `
    -Execute "powershell.exe" `
    -Argument '-NoProfile -ExecutionPolicy Bypass -File "D:\Jenkins\tasks\stsinstall.ps1" -Version "$(Arg0)"'

$principal = New-ScheduledTaskPrincipal `
    -UserId "SYSTEM" `
    -LogonType ServiceAccount `
    -RunLevel Highest

Register-ScheduledTask `
    -TaskName "stsinstall" `
    -TaskPath "\Jenkins\tasks\" `
    -Action $action `
    -Principal $principal
