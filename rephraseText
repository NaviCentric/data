async function scrollUntilVisible(
  grid: Locator,
  target: Locator,
  step = 300,
  maxScrolls = 50
) {
  for (let i = 0; i < maxScrolls; i++) {
    if (await target.isVisible()) return;

    await grid.evaluate((el, step) => {
      const cells = el.querySelector('.wj-cells');
      if (cells) {
        cells.scrollTop += step;
      }
    }, step);
  }

  throw new Error('Element not found after scrolling.');
}
