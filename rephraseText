stage('Install STS Desktop') {
    when {
        expression {
            return params.SETUP_STS_DESKTOP && env.STS_DESKTOP_SETUP_REQUIRED == 'true'
        }
    }
    steps {
        powershell '''
            & "D:\\Jenkins\\tasks\\run-sts-install.ps1" -Version "$env:STS_DESKTOP_VERSION"
        '''
    }
}
