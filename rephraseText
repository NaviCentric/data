/**
 * Data provider fixture
 * Provides data access utilities and DB connectivity.
 */

import { test as base } from '../../core/infrastructure/index';
import type { APIRequestContext, Page } from '@playwright/test';
import {
  DataPrerequisiteValidator,
  DataSeekService,
  ScenarioDataProvider,
  TestDataFactory,
} from '../../data-management/index';
import { DatabaseRepository } from '../../components/database/index';
import type { ComponentSuite } from '../../components/factory/index';
import {
  componentsFixturesNoPage,
  componentsFixturesWithPage,
  type ComponentsFixture,
} from './components.fixture';

export interface TestDataProvider {
  testDataFactory: TestDataFactory;
  dataSeekService: DataSeekService;
  scenarioData: ScenarioDataProvider;
}

export interface DataProviderFixture {
  dataProvider: TestDataProvider;
  scenarioData: ScenarioDataProvider;
  testDataFactory: TestDataFactory;
  dataSeekService: DataSeekService;
  prerequisiteValidator: DataPrerequisiteValidator;
  database: DatabaseRepository;
}

export const dataProviderFixturesWithPage = {
  dataProvider: async (
    {
      page,
      request,
      components,
    }: { page: Page; request: APIRequestContext; components: ComponentSuite },
    use: (value: TestDataProvider) => Promise<void>
  ): Promise<void> => {
    const testDataFactory = new TestDataFactory(request, page, components);
    const dataSeekService = new DataSeekService(request, page, components);
    const scenarioData = new ScenarioDataProvider(request, page, components);

    const dataProvider: TestDataProvider = {
      testDataFactory,
      dataSeekService,
      scenarioData,
    };

    await use(dataProvider);
    await scenarioData.cleanupAll();
  },

  scenarioData: async (
    {
      page,
      request,
      components,
    }: { page: Page; request: APIRequestContext; components: ComponentSuite },
    use: (value: ScenarioDataProvider) => Promise<void>
  ): Promise<void> => {
    const provider = new ScenarioDataProvider(request, page, components);
    await use(provider);
    await provider.cleanupAll();
  },

  testDataFactory: async (
    {
      page,
      request,
      components,
    }: { page: Page; request: APIRequestContext; components: ComponentSuite },
    use: (value: TestDataFactory) => Promise<void>
  ): Promise<void> => {
    const factory = new TestDataFactory(request, page, components);
    await use(factory);
  },

  dataSeekService: async (
    {
      page,
      request,
      components,
    }: { page: Page; request: APIRequestContext; components: ComponentSuite },
    use: (value: DataSeekService) => Promise<void>
  ): Promise<void> => {
    const service = new DataSeekService(request, page, components);
    await use(service);
  },

  prerequisiteValidator: async (
    { request }: { request: APIRequestContext },
    use: (value: DataPrerequisiteValidator) => Promise<void>
  ): Promise<void> => {
    void request;
    const validator = new DataPrerequisiteValidator();
    await use(validator);
  },

  database: async (
    { request }: { request: APIRequestContext },
    use: (value: DatabaseRepository) => Promise<void>
  ): Promise<void> => {
    void request;
    const db = new DatabaseRepository();
    const isValid = await db.validateConnection();
    if (!isValid) {
      throw new Error('Database connection failed');
    }

    await use(db);
    await db.closeConnection();
  },
};

